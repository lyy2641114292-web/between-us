# ============================================================
# DeepSeek API 配置
# ------------------------------------------------------------
# 【在这里填写你的密钥】
#   1. 打开 https://platform.deepseek.com/api_keys 创建
#   2. 把 sk-xxxxxxxx 整串粘贴到下面等号后面，不要加引号
#   3. 保存本文件后重启服务（npm run dev）
#
# ⚠️ 本文件只在本机使用，已在 .gitignore 中排除，不会被提交。
# ⚠️ 密钥只由后端 server/ 读取，永远不会出现在前端代码或浏览器里。
# ============================================================

DEEPSEEK_API_KEY=

# 模型：deepseek-flash（便宜够用）或 deepseek-v4-pro（更强，约 4 倍价格）
DEEPSEEK_MODEL=deepseek-flash

# 后端端口
PORT=8788

# 监听地址。本机开发用 127.0.0.1；部署到服务器后要改成 0.0.0.0，否则外网连不上
HOST=127.0.0.1

# 单次请求超时（毫秒）
AI_TIMEOUT_MS=30000

# 每个 IP 每分钟允许的模型调用次数（防密钥被刷，同时不能卡住正常使用）
# 一次完整五阶段会话（含阶段 01 / 03 的后台预取）大约需要 20~30 次。
# 只统计真正会调用模型的请求，参数错误之类的不计数。
RATE_LIMIT=60

# ------------------------------------------------------------
# 部署到公网时才需要设置（本机开发保持默认即可）
# ------------------------------------------------------------
# 是否信任反向代理（Nginx / Caddy / 云平台）传来的 X-Forwarded-For。
# 部署在代理后面时设为 true，否则限流会把所有访客当成同一个 IP。
TRUST_PROXY=false

# 允许跨域调用后端的前端来源（逗号分隔）。
# 留空 = 允许任意来源，仅适合本机开发。
# 一旦后端放到公网，务必填上你的网页域名，否则别人可以直接拿你的后端烧密钥：
#   ALLOWED_ORIGINS=https://your-site.vercel.app,https://your-domain.com
# ALLOWED_ORIGINS=

# ------------------------------------------------------------
# 前端调用后端的地址（可选，只在本机开发以外的情况需要）
# ------------------------------------------------------------
# 留空 = 前端请求相对路径 /api，由 Vite 代理转发到本机 8788（开发默认）。
# 只有当「网页」和「后端」不在同一个域名下时，才需要取消下面的注释并填写，
# 例如把前端静态文件传到 Vercel、后端单独跑在别的机器上：
#   VITE_API_BASE=https://你的后端域名
# 填完后必须重新 npm run build，否则改动不会进产物。
# 注意：这是前端构建时变量，会出现在浏览器可见的代码里，只能填地址，不能填密钥。
# VITE_API_BASE=
